# ============= VOICE-DRIVEN CLINICAL ENGINE =============

class VoiceDrivenClinicalEngine:
    def __init__(self):
        self.ai_client = client
        self.trial_criteria = COMPLETE_TRIAL_CRITERIA
        self.guidelines = INTERNATIONAL_GUIDELINES
        
    def process_voice_to_recommendations(self, audio_file) -> Dict:
        """Complete pipeline from voice to recommendations"""
        
        # Step 1: Transcribe audio
        transcript = self.transcribe_audio(audio_file)
        
        # Step 2: Extract patient data and match trials
        analysis = self.analyze_patient_and_match_trials(transcript)
        
        # Step 3: Compare guidelines and make recommendations
        recommendations = self.generate_comprehensive_recommendations(analysis)
        
        return {
            "transcript": transcript,
            "analysis": analysis,
            "recommendations": recommendations
        }
    
    def transcribe_audio(self, audio_file) -> str:
        """Transcribe audio using Whisper"""
        try:
            transcript = self.ai_client.audio.transcriptions.create(
                model="whisper-1",
                file=audio_file,
                language="en"
            )
            return transcript.text
        except Exception as e:
            return f"Transcription error: {str(e)}"
    
    def analyze_patient_and_match_trials(self, transcript: str) -> Dict:
        """Extract patient data and match against ALL trials"""
        
        prompt = f"""
        You are a clinical trial matching expert. Analyze this patient presentation and match against ALL lipid trials.
        
        PATIENT PRESENTATION:
        {transcript}
        
        COMPLETE TRIAL CRITERIA:
        {self.trial_criteria}
        
        For EACH trial, determine:
        1. Which inclusion criteria are MET (be specific)
        2. Which inclusion criteria are NOT MET (be specific)
        3. Which exclusion criteria are TRIGGERED (if any)
        4. Overall eligibility (ELIGIBLE, EXCLUDED, or PARTIAL MATCH)
        5. Match percentage based on inclusion criteria
        
        Also extract:
        - Patient demographics (age, sex)
        - All lab values mentioned
        - All medical conditions
        - Current medications
        - Risk factors
        
        IMPORTANT:
        - Check EVERY inclusion and exclusion criterion
        - Note missing information that would be needed
        - Calculate accurate match percentages
        - Identify the BEST matching trials
        
        Return a structured analysis with:
        1. Patient summary
        2. Trial matching results for ALL 9 trials
        3. Top 3 recommended trials with reasoning
        4. Missing information that would improve matching
        """
        
        try:
            response = self.ai_client.chat.completions.create(
                model="gpt-4",
                messages=[
                    {"role": "system", "content": "You are a clinical trial matching expert. Be thorough and precise."},
                    {"role": "user", "content": prompt}
                ],
                temperature=0.1,
                max_tokens=3000
            )
            
            return response.choices[0].message.content
            
        except Exception as e:
            return f"Analysis error: {str(e)}"
    
    def generate_comprehensive_recommendations(self, analysis: str) -> Dict:
        """Generate guideline comparisons and final recommendations"""
        
        prompt = f"""
        Based on this patient analysis and trial matching results, provide comprehensive recommendations.
        
        PATIENT ANALYSIS:
        {analysis}
        
        INTERNATIONAL GUIDELINES:
        {self.guidelines}
        
        Please provide:
        
        1. GUIDELINE COMPARISON:
        - What would ACC/AHA 2018 recommend for this patient?
        - What would ESC/EAS 2019 recommend?
        - What would NICE 2023 recommend?
        - Which guideline is BEST for this specific patient and WHY?
        - Would this patient benefit from following a different country's guideline? Explain.
        
        2. RISK STRATIFICATION:
        - Calculate risk category (Very High/High/Moderate/Low)
        - Explain the reasoning
        - Note key risk factors
        
        3. LDL TARGET:
        - Specific target based on best guideline
        - Current gap to goal
        - Expected timeline to achieve
        
        4. TREATMENT RECOMMENDATIONS:
        - PRIMARY: Specific drug and dose
        - If already on therapy: What to add or change
        - Alternative if intolerant
        - Non-pharmacologic interventions
        
        5. TRIAL EVIDENCE:
        - Which trial evidence supports your recommendation?
        - Expected outcomes based on trial data
        - NNT (number needed to treat) if applicable
        
        6. MONITORING PLAN:
        - When to recheck labs
        - What to monitor for safety
        - When to consider escalation
        
        7. KEY CLINICAL PEARLS:
        - Important considerations for this specific patient
        - Potential drug interactions
        - Special populations considerations
        
        BE SPECIFIC: Include exact drug names, doses, targets, and timelines.
        EXPLAIN YOUR REASONING: Why is your recommendation best for THIS patient?
        """
        
        try:
            response = self.ai_client.chat.completions.create(
                model="gpt-4",
                messages=[
                    {"role": "system", "content": "You are a lipid specialist providing evidence-based recommendations. Be specific and explain your reasoning."},
                    {"role": "user", "content": prompt}
                ],
                temperature=0.2,
                max_tokens=2500
            )
            
            return response.choices[0].message.content
            
        except Exception as e:
            return f"Recommendation error: {str(e)}"

